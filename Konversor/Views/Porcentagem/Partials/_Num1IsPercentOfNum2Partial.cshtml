@model Konversor.ViewModels.Num1IsPercentOfNum2ViewModel

<form asp-action="CalculateNum1IsPercentOfNum2" method="post">
    <ul class="list-unstyled ps-0">
        <p>
            O valor
                <input asp-for="Num1" class="form-control-sm" placeholder="--">
            é qual porcentagem de
            <input asp-for="Num2" class="form-control-sm" placeholder="--">
            ?
        </p>
        @if (Model.Result.HasValue)
        {
            <div class="alert alert-success mt-3">
                Resultado:
                <strong>@Model.Result%</strong>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-success mt-3">
                Erro:
                <strong>@Model.Error</strong>
            </div>
        }
        <button class="btn btn-primary">Calcular</button>
    </ul>
</form>
