@model Konversor.ViewModels.DecreasePercentageViewModel



<form asp-action="CalculateDecreasePercentOf" method="post">
    <ul class="list-unstyled ps-0">
        <p>
            Um valor de
                <input asp-for="InitialValue" class="form-control-sm" placeholder="--">
            que DIMINUIU para
                <input asp-for="FinalValue" class="form-control-sm" placeholder="--">
            Qual foi a diminuição percentual?
        </p>
        @if (Model.Result.HasValue)
        {
            <div class="alert alert-success mt-3">
                Resultado:
                <strong>@Model.Result%</strong>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-success mt-3">
                Erro:
                <strong>@Model.Error</strong>
            </div>
        }
        <button class="btn btn-primary">Calcular</button>
    </ul>
</form>
