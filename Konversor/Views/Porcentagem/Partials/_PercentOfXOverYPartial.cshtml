@model Konversor.ViewModels.PercentOfXOverYViewModel

<form asp-action="CalculatePercentOfXOverY" method="post">
    <ul class="list-unstyled ps-0">
        <p>
            O valor
                <input asp-for="ValueX" class="form-control-sm" placeholder="--">
            sobre o valor
                <input asp-for="ValueY" class="form-control-sm" placeholder="--">
            é quantos por cento?
        </p>
        @if (Model.Result.HasValue)
        {
            <div class="alert alert-success mt-3">
                Resultado:
                <strong>@Model.Result%</strong>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-success mt-3">
                Erro:
                <strong>@Model.Error</strong>
            </div>
        }
        <button class="btn btn-primary">Calcular</button>
    </ul>
</form>
