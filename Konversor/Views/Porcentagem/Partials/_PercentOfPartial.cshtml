@model Konversor.ViewModels.PercentOfViewModel

<form asp-action="CalculatePercentOf" method="post">
    <ul class="list-unstyled ps-0">
        <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap" style="margin-bottom:12px;">

            <span>Quanto é</span>

            <div class="input-group" style="width:120px;">
                <input asp-for="Percentage" class="form-control" placeholder="--">
                <span class="input-group-text">%</span>
            </div>

            <span>de</span>

            <input asp-for="Value"
                   class="form-control"
                   style="width:120px;"
                   placeholder="--">

            <span>?</span>

        </div>
        @if (Model.Result.HasValue)
        {
            <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">
                <div class="alert alert-success mt-3" style="width:120px;">
                    <span>Resultado:</span>
                    <strong>@Model.Result</strong>
                </div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">
                <div class="alert alert-warning mt-3">
                    <span>Erro:</span>
                    <strong>@Model.Error</strong>
                </div>
            </div>
        }
        <button class="btn btn-primary">Calcular</button>
    </ul>
</form>
