<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Konversor</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Header -->
    <header>
        <nav class="navbar navbar-dark bg-dark">
            <div class="container-fluid">
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#sidebarMenu"
                        aria-controls="sidebarMenu"
                        aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    Konversor
                </a>
            </div>
        </nav>
    </header>

    <!-- Sidebar (retraída por padrão, aberta pelo botão sanduíche) -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarMenuLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="sidebarMenuLabel">Menu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
        </div>
        <div class="offcanvas-body">

            <h6 class="text-uppercase text-muted">Matemática</h6>

            <div class="list-group list-group-flush mb-4">
                <a asp-controller="Porcentagem"
                   asp-action="Index"
                   class="list-group-item list-group-item-action">
                    Porcentagem
                </a>

                <a asp-controller="Mmc"
                   asp-action="Index"
                   class="list-group-item list-group-item-action">
                    MMC
                </a>

                <a href="#" class="list-group-item list-group-item-action">
                    MDC
                </a>

                <a href="#" class="list-group-item list-group-item-action">
                    Resto da divisão
                </a>
            </div>

            <h6 class="text-uppercase text-muted">Computação</h6>

            <div class="list-group list-group-flush">
                <a href="#" class="list-group-item list-group-item-action">
                    Endereços de rede
                </a>

                <a href="#" class="list-group-item list-group-item-action">
                    CPF
                </a>

                <a href="#" class="list-group-item list-group-item-action">
                    Inverter string
                </a>

                <a href="#" class="list-group-item list-group-item-action">
                    Codificar MD5
                </a>
            </div>

        </div>
    </div>

    <!-- Conteúdo principal -->
    <div class="container-fluid flex-grow-1 py-4">

        @RenderBody()

    </div>

    <!-- Footer -->
    <footer class="border-top py-3 mt-auto bg-light">
        <div class="container">
            &copy; 2026 - Konversor
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
