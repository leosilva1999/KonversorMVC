<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Konversor</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Header -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    Konversor
                </a>
            </div>
        </nav>
    </header>

    <!-- Conteúdo principal -->
    <div class="container-fluid flex-grow-1">

        <div class="row h-100">

            <!-- Sidebar -->
            <aside class="col-md-3 col-lg-2 border-end bg-light py-3">

                <h6 class="text-uppercase text-muted">Matemática</h6>

                <div class="list-group list-group-flush mb-4">
                    <a asp-controller="Porcentagem"
                       asp-action="Index"
                       class="list-group-item list-group-item-action">
                        Porcentagem
                    </a>

                    <a href="#" class="list-group-item list-group-item-action">
                        MMC
                    </a>

                    <a href="#" class="list-group-item list-group-item-action">
                        MDC
                    </a>

                    <a href="#" class="list-group-item list-group-item-action">
                        Resto da divisão
                    </a>
                </div>

                <h6 class="text-uppercase text-muted">Computação</h6>

                <div class="list-group list-group-flush">
                    <a href="#" class="list-group-item list-group-item-action">
                        Endereços de rede
                    </a>

                    <a href="#" class="list-group-item list-group-item-action">
                        CPF
                    </a>

                    <a href="#" class="list-group-item list-group-item-action">
                        Inverter string
                    </a>

                    <a href="#" class="list-group-item list-group-item-action">
                        Codificar MD5
                    </a>
                </div>

            </aside>

            <!-- Área principal -->
            <main class="col-md-9 col-lg-10 py-4">

                <div class="container-fluid">

                    @RenderBody()

                </div>

            </main>

        </div>

    </div>

    <!-- Footer -->
    <footer class="border-top py-3 mt-auto bg-light">
        <div class="container">
            &copy; 2026 - Konversor
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>